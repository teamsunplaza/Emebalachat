# ==============================================================================
# Emebalachat - Git Ignore Rules
# ==============================================================================

# Build outputs & binaries
build/
build-r18/
build-*/
bin/
out/
[Dd]ebug/
[Rr]elease/
x64/
*.exe
*.dll
*.lib
*.obj
*.pdb
*.ilk
*.exp
*.res

# AI Models & weights
models/
*.gguf
*.bin
*.safetensors
*.onnx

# Installer outputs
installer/output/
*.iss.bak

# Local runtime configs & temporary files
config.json
*.tmp

# Internal session reports & audit docs (local-only, never published)
docs/

# Python caches & virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
.env

# Legacy prototype
MVP_Emebalachat/

# Build/test logs & throwaway verification artifacts (VP/sub-mode session temp)
*.log
filtered_log.txt

# Temporary tooling scripts & scratch files (session-scoped, never published)
tools_tmp_*
scratch_test.cpp
tmp.cpp
nul

# IDE & OS metadata
.vs/
.vscode/
.idea/
*.user
*.suo
CMakeUserPresets.json
Thumbs.db
Desktop.ini
.DS_Store
