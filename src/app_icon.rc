// REQ-R2 (session 260905_0001): application icon resource.
// Embeds the Emebala Chat app icon (multi-size .ico generated from
// assets/Emebala_Chat_Appicon_small.png) into the executable so Explorer,
// the taskbar, Alt+Tab, and the tray use the branded icon instead of the
// default generic Win32 application icon.
//
// Path is relative to THIS .rc file (src/), so ../assets/... resolves to the
// repo's assets directory. IDI_ICON1 is the conventional primary app icon id;
// Windows uses the lowest-numbered ICON resource as the file's icon.
#include <windows.h>

IDI_ICON1 ICON "..\\assets\\Emebala_Chat_Appicon.ico"

// REQ-B8: VERSIONINFO resource for Explorer file properties.
// Exposes version, product name, and company in the Details tab of
// the executable's Properties dialog (right-click -> Properties).
// 260930_0004: every version field is macro-driven. CMake passes
// EMEBALACHAT_RC_VER_{MAJOR,MINOR,PATCH} and the pre-quoted
// EMEBALACHAT_RC_VER_STR via set_source_files_properties COMPILE_OPTIONS
// (derived from project(VERSION) in CMakeLists.txt), so a version bump
// never touches this file. rc.exe's preprocessor has no stringize operator,
// hence the string define arrives quoted from CMake.
1 VERSIONINFO
 FILEVERSION EMEBALACHAT_RC_VER_MAJOR,EMEBALACHAT_RC_VER_MINOR,EMEBALACHAT_RC_VER_PATCH,0
 PRODUCTVERSION EMEBALACHAT_RC_VER_MAJOR,EMEBALACHAT_RC_VER_MINOR,EMEBALACHAT_RC_VER_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Team Sunplaza\0"
            VALUE "FileDescription",  "Emebala Chat - Real-time Translation\0"
            VALUE "FileVersion",      EMEBALACHAT_RC_VER_STR "\0"
            VALUE "InternalName",     "Emebala_chat\0"
            VALUE "LegalCopyright",   "Copyright (C) 2025-2026 Team Sunplaza\0"
            VALUE "OriginalFilename", "Emebala_chat.exe\0"
            VALUE "ProductName",      "Emebala Chat\0"
            VALUE "ProductVersion",   EMEBALACHAT_RC_VER_STR "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
